# Copy to .env and fill in for local development.

# The multiplayer server (see server/). Expo Go on a physical device can't
# resolve "localhost" to your dev machine -- use your LAN IP there instead,
# e.g. http://192.168.1.23:4000. Day-to-day this should point at your LOCAL
# server (server/'s `npm run dev`, itself pointed at your local Postgres --
# see server/README.md), not the deployed Railway one, so ordinary
# development never touches production. Swap in the public wss:// URL only
# to deliberately smoke-test against production once a change has shipped.
EXPO_PUBLIC_SERVER_URL=http://localhost:4000

# Production (Railway, see README.md's "Redeploying the server to Railway"):
# EXPO_PUBLIC_SERVER_URL=https://server-production-62b1.up.railway.app
