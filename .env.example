# Copy to .env and fill in for local development.

# The multiplayer server (see server/). Expo Go on a physical device can't
# resolve "localhost" to your dev machine -- use your LAN IP there instead,
# e.g. http://192.168.1.23:4000. Once deployed to Railway, use the public
# wss:// URL.
EXPO_PUBLIC_SERVER_URL=http://localhost:4000
