# Local dev DB (see server/README.md's "Local development vs. production"
# for the one-time `CREATE ROLE`/`CREATE DATABASE` setup). Never point this
# .env at the real Neon database -- that lives in a separate,
# never-committed server/.env.production, used only by the `:remote` npm
# scripts to deliberately push a tested change to production.
DATABASE_URL=postgres://rockstyle_dev:password@127.0.0.1:5432/rockstyle_chess_dev
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Should match how clients reach this server (EXPO_PUBLIC_SERVER_URL in the
# app's own .env) -- used to build correct callback/redirect URLs.
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated web origins allowed to call the API/Socket.IO with cookies
# (browsers only -- the native Expo app doesn't send an Origin header).
WEB_CLIENT_ORIGINS=http://localhost:8081
# Must match app.json's "scheme" -- used to validate OAuth/deep-link redirects.
MOBILE_APP_SCHEME=rockstylechess
